---
// A screenshot of the app, in the visitor's language and appearance.
//
// The captures are made by `demo/make-screens.sh` from the demo mailbox,
// as src/assets/screens/<lang>/<theme>/<name>-<light|dark>.png, at twice
// the size of the window, in each theme of the app (src/shots.ts). At build time Astro turns each into WebP files of several
// widths, and the browser picks the one that fits the screen. The French
// page falls back on the English capture, and a capture not made yet shows
// a frame with its description, so the site builds at every stage.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Lang } from '../i18n';
import { SHOT_THEMES, DEFAULT_SHOT_THEME, type ShotTheme } from '../shots';
import ShotThemes from './ShotThemes.astro';

interface Props {
  lang: Lang;
  name: string;
  alt: string;
  eager?: boolean;
  /** A line under the screenshot, saying what it shows for the reader. */
  caption?: string;
  /** Puts the caption on the right, out of the reading flow of the page. */
  captionEnd?: boolean;
  /** The switch of the theme of the screenshots, on the left of the
   *  caption (ShotThemes.astro); it changes every screenshot of the page. */
  themeSwitch?: boolean;
  /** Always this theme, whatever the visitor chose on the switch: the
   *  page of the guide that shows each theme (docs/themes.mdx). */
  theme?: ShotTheme;
}

const { lang, name, alt, eager = false, caption, captionEnd = false, themeSwitch = false, theme } = Astro.props;

// TypeScript note: `import.meta.glob` is resolved by the bundler: it lists
// the matching files at build time and imports them; `eager` imports them
// at once instead of returning functions.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*/*/*.png', { eager: true });
const at = (l: string, theme: string, mode: string) => files[`../assets/screens/${l}/${theme}/${name}-${mode}.png`]?.default;
// A capture of this language and theme; else the English one; else the
// default theme's, so that a theme not photographed yet still shows a
// screenshot.
const find = (theme: string, mode: string) =>
  at(lang, theme, mode) ?? at('en', theme, mode) ?? at(lang, DEFAULT_SHOT_THEME, mode) ?? at('en', DEFAULT_SHOT_THEME, mode);

// The page is at most about 1,150 CSS pixels wide; the widths cover phones
// up to large Retina screens.
const sizes = '(min-width: 74rem) 70rem, 94vw';
// The large view fills the screen, so the browser picks a bigger file.
const bigSizes = '96vw';
const s = t(lang).shot;
const options = { format: 'webp' as const, quality: 82, widths: [640, 1024, 1440, 1920, 2560] };

// One picture per theme of the app (src/shots.ts). Only the one of the
// theme chosen is displayed (the CSS below reads `data-shot-theme` on
// <html>); the others are `display: none`, and a lazy image that is not
// displayed is not downloaded, so a visitor only loads the theme shown.
const variants = (
  await Promise.all(
    (theme ? [theme] : SHOT_THEMES).map(async (variant) => {
      const lightSrc = find(variant, 'light');
      const darkSrc = find(variant, 'dark');
      const light = lightSrc ? await getImage({ src: lightSrc, ...options }) : null;
      const dark = darkSrc ? await getImage({ src: darkSrc, ...options }) : null;
      const main = light ?? dark;
      return main ? { theme: variant, light, dark, main, probe: lightSrc ?? darkSrc } : null;
    }),
  )
).filter((v) => v !== null);
const probe = variants[0]?.probe;
// The size of the window: half the pixels of the capture.
const width = probe ? Math.round(probe.width / 2) : 1280;
const height = probe ? Math.round(probe.height / 2) : 800;
---

<figure class:list={['shot', { 'with-switch': themeSwitch }]}>
  {
    variants.length ? (
      <>
        <button type="button" class="zoom" aria-label={`${s.zoom}: ${alt}`} aria-haspopup="dialog">
          {variants.map((v) => (
            <picture class:list={{ variant: !theme }} data-shot={v.theme}>
              {v.light && v.dark && <source type="image/webp" media="(prefers-color-scheme: dark)" srcset={v.dark.srcSet.attribute} sizes={sizes} />}
              <img
                src={v.main.src}
                srcset={v.main.srcSet.attribute}
                sizes={sizes}
                alt={alt}
                width={width}
                height={height}
                loading={eager && (theme || v.theme === DEFAULT_SHOT_THEME) ? 'eager' : 'lazy'}
                fetchpriority={eager && (theme || v.theme === DEFAULT_SHOT_THEME) ? 'high' : undefined}
                decoding="async"
              />
            </picture>
          ))}
        </button>
        {/* The large view. A closed dialog is not displayed, so its lazy
            images are only downloaded when the visitor opens it. */}
        <dialog class="viewer" aria-label={alt}>
          {variants.map((v) => (
            <picture class:list={{ variant: !theme }} data-shot={v.theme}>
              {v.light && v.dark && <source type="image/webp" media="(prefers-color-scheme: dark)" srcset={v.dark.srcSet.attribute} sizes={bigSizes} />}
              <img src={v.main.src} srcset={v.main.srcSet.attribute} sizes={bigSizes} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
            </picture>
          ))}
          <span class="hint">{s.close}</span>
        </dialog>
      </>
    ) : (
      <div class="pending" role="img" aria-label={alt}>
        <span>{s.pending}</span>
        <small>{alt}</small>
      </div>
    )
  }
  {themeSwitch && (
    <div class="switch">
      <ShotThemes lang={lang} />
    </div>
  )}
  {caption && <figcaption class:list={{ end: captionEnd }}>{caption}</figcaption>}
</figure>

<script>
  // TypeScript note: Astro bundles this script once for the page, however
  // many screenshots there are, so it wires every one of them.
  //
  // A click on a screenshot opens its large view in a modal <dialog>: the
  // browser then closes it on Escape by itself, keeps the keyboard inside,
  // and gives the focus back to the screenshot. A click anywhere in the
  // large view closes it too.
  for (const figure of document.querySelectorAll<HTMLElement>('.shot')) {
    const button = figure.querySelector<HTMLButtonElement>('.zoom');
    const viewer = figure.querySelector<HTMLDialogElement>('.viewer');
    if (!button || !viewer) continue;
    button.addEventListener('click', () => viewer.showModal());
    viewer.addEventListener('click', () => viewer.close());
  }
</script>

<style>
  /* No margin of its own (a <figure> has one by default), with no weight
     either (`:where`): in a page of text, the spacing of the text applies
     (`.prose > * + *`, global.css). Global, or Astro would add the
     attribute of the component outside `:where` and give it weight. */
  :global(:where(.shot)) {
    margin: 0;
  }
  /* The screenshot, then on one line the switch on the left and the
     caption on the right; one under the other on a phone. */
  .with-switch {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.5rem;
    align-items: start;
  }
  .with-switch > .zoom,
  .with-switch > .pending {
    grid-column: 1 / -1;
  }
  .switch {
    margin-top: 0.8rem;
  }
  .with-switch figcaption.end {
    justify-self: end;
  }
  @media (max-width: 40rem) {
    .with-switch {
      grid-template-columns: 1fr;
    }
    .with-switch figcaption.end {
      justify-self: start;
      text-align: left;
    }
  }
  /* One picture per theme: the default one until the visitor chooses
     (data-shot-theme on <html>, src/shots.ts). */
  .variant {
    display: none;
  }
  /* A screenshot in a theme of its own (`theme`): always shown. */
  picture:not(.variant) {
    display: block;
  }
  .variant[data-shot='clean'] {
    display: block;
  }
  :global(:root[data-shot-theme]) .variant[data-shot='clean'] {
    display: none;
  }
  :global(:root[data-shot-theme='clean']) .variant[data-shot='clean'],
  :global(:root[data-shot-theme='regular']) .variant[data-shot='regular'],
  :global(:root[data-shot-theme='geek']) .variant[data-shot='geek'],
  :global(:root[data-shot-theme='minimal']) .variant[data-shot='minimal'] {
    display: block;
  }
  figcaption {
    margin: 0.9rem 0.25rem 0;
    max-width: 44rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  figcaption.end {
    margin-left: auto;
    text-align: right;
  }
  /* The screenshot is a button that opens the large view. */
  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 12px;
  }
  .zoom:focus-visible {
    outline: 3px solid var(--accent, currentColor);
    outline-offset: 4px;
  }
  .viewer {
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 2vh 2vw;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .viewer[open] {
    display: grid;
    place-items: center;
  }
  .viewer::backdrop {
    background: rgba(12, 20, 14, 0.88);
  }
  .viewer img {
    display: block;
    width: auto;
    height: auto;
    max-width: 96vw;
    max-height: 92vh;
    border-radius: 10px;
  }
  .hint {
    position: fixed;
    top: 0.8rem;
    right: 1rem;
    color: #f2f5ef;
    font-family: var(--font-body);
    font-size: 0.9rem;
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] img {
      animation: grow 160ms ease-out;
    }
    @keyframes grow {
      from {
        transform: scale(0.96);
        opacity: 0.6;
      }
    }
  }
  .zoom img,
  .pending {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--shot-border);
    box-shadow: 0 30px 60px -30px rgba(20, 40, 24, 0.45);
  }
  .pending {
    aspect-ratio: 16 / 10;
    background: var(--bg-2);
    display: grid;
    place-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 2rem;
    color: var(--ink-2);
    font-family: var(--font-display);
  }
  .pending small {
    font-family: var(--font-body);
    max-width: 28rem;
  }
</style>
