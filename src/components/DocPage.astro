---
// A page of the user guide, or (id null) the list of its pages.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, href, ISSUES, type Lang } from '../i18n';
import { docsOf, slugOf } from '../docs';

interface Props {
  lang: Lang;
  id: string | null;
}
const { lang, id } = Astro.props;
const s = t(lang);
const list = await docsOf(lang);
const index = list.findIndex((e) => e.id === id);
const entry = index >= 0 ? list[index] : null;
const { Content } = entry ? await render(entry) : { Content: null };
const prev = index > 0 ? list[index - 1] : null;
const next = index >= 0 && index < list.length - 1 ? list[index + 1] : null;
const link = (e: (typeof list)[number]) => href(lang, `/docs/${slugOf(e)}/`);
const title = entry ? `${entry.data.title} – NiceMailer` : `${s.docs.title} – NiceMailer`;
const description = entry ? entry.data.description : s.meta.description;
---

<Base lang={lang} title={title} description={description}>
  <div class="wrap docs">
    <aside>
      {/* The pages of the guide. On a phone they would push the text a
          screen down, so they fold into one line there (closed by the script
          below); on a wider screen the line is hidden and the list always
          shown. Without JavaScript, the list stays open. */}
      <details class="toc" open>
        <summary>
          <span>{s.docs.contents}</span>
          {entry && <span class="here">{entry.data.title}</span>}
        </summary>
      <p class="aside-title"><a href={href(lang, '/docs/')}>{s.docs.title}</a></p>
      <ol>
        {
          list.map((e) => (
            <li>
              <a href={link(e)} aria-current={e.id === id ? 'page' : undefined}>
                {e.data.title}
              </a>
            </li>
          ))
        }
      </ol>
      </details>
      <script is:inline>
        (function () {
          var toc = document.querySelector('.toc');
          var phone = matchMedia('(max-width: 50rem)');
          if (!toc) return;
          // Folded on a phone; always open on a wider screen, also when the
          // window is made wider after it was folded.
          if (phone.matches) toc.removeAttribute('open');
          phone.addEventListener('change', function () {
            if (!phone.matches) toc.setAttribute('open', '');
          });
        })();
      </script>
    </aside>
    <article>
      {
        entry && Content ? (
          <>
            <h1>{entry.data.title}</h1>
            <p class="doc-lead">{entry.data.description}</p>
            <div class="prose">
              <Content />
            </div>
            <nav class="pager" aria-label={s.docs.onThisPage}>
              {prev ? (
                <a href={link(prev)}>
                  <small>{s.docs.prev}</small>
                  {prev.data.title}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="next" href={link(next)}>
                  <small>{s.docs.next}</small>
                  {next.data.title}
                </a>
              )}
            </nav>
          </>
        ) : (
          <>
            <h1>{s.docs.title}</h1>
            <p class="doc-lead">{s.docs.lead}</p>
            <ol class="index">
              {list.map((e) => (
                <li>
                  <a href={link(e)}>{e.data.title}</a>
                  <p>{e.data.description}</p>
                </li>
              ))}
            </ol>
          </>
        )
      }
      <p class="issue"><a href={ISSUES}>{s.docs.edit}</a></p>
    </article>
  </div>
</Base>

<style>
  /* The text on the left, where it is on every other page; the list of
     pages on the right. On a phone the list comes first, above the text. */
  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    grid-template-areas: 'main side';
    gap: 3.5rem;
    padding-top: 2.5rem;
  }
  article {
    grid-area: main;
  }
  aside {
    grid-area: side;
    position: sticky;
    top: 1.5rem;
    align-self: start;
    font-size: 1rem;
  }
  .toc summary {
    display: none;
  }
  .aside-title {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 0.8rem;
  }
  .aside-title a {
    color: var(--ink);
    text-decoration: none;
  }
  aside ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
    border-left: 1px solid var(--line);
  }
  aside li a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
  }
  aside li a:hover {
    color: var(--ink);
  }
  aside li a[aria-current='page'] {
    color: var(--ink);
    border-left-color: var(--leaf);
  }
  /* The title and its lead as on the other pages (ContentPage.astro). */
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    letter-spacing: -0.03em;
  }
  .doc-lead {
    margin-top: 1rem;
    margin-bottom: 2.5rem;
    font-size: 1.3rem;
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .index {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
    max-width: var(--measure);
  }
  .index a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .index p {
    margin-top: 0.25rem;
    color: var(--ink-2);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    max-width: var(--measure);
    border-top: 1px solid var(--line);
    padding-top: 1.2rem;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
  }
  .pager small {
    font-family: var(--font-body);
    font-weight: 400;
    color: var(--ink-2);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
  .issue {
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }
  .issue a {
    color: var(--ink-2);
  }
  @media (max-width: 50rem) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'side' 'main';
      gap: 1.5rem;
      padding-top: 1rem;
    }
    aside {
      position: static;
    }
    .toc {
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 0 1rem;
    }
    .toc summary {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      padding: 0.8rem 0;
      cursor: pointer;
      list-style: none;
      font-family: var(--font-display);
      font-weight: 700;
    }
    .toc summary::-webkit-details-marker {
      display: none;
    }
    /* A chevron that points down when folded, up when open. */
    .toc summary::after {
      content: '';
      margin-left: auto;
      align-self: center;
      width: 0.5rem;
      height: 0.5rem;
      border-right: 2px solid var(--ink-2);
      border-bottom: 2px solid var(--ink-2);
      transform: translateY(-25%) rotate(45deg);
    }
    .toc[open] summary::after {
      transform: translateY(25%) rotate(-135deg);
    }
    .here {
      font-family: var(--font-body);
      font-weight: 400;
      color: var(--ink-2);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .toc .aside-title {
      display: none;
    }
    .toc ol {
      margin-bottom: 1rem;
    }
  }
</style>
