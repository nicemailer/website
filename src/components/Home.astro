---
// The home page, in both languages (src/pages/index.astro, fr/index.astro).
// It follows the pitch: what the app is, the proof, the three pillars, the
// objections lifted (trying, moving, trusting), the questions, the button.
import Base from '../layouts/Base.astro';
import Shot from './Shot.astro';
import Download from './Download.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, href, REPO, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);

const LINKEDIN = 'https://www.linkedin.com/in/achille/';
const X = 'https://x.com/achilleberes';
// The author's portrait, shown small beside the signature. It is optional:
// without src/assets/author.jpg (or .png) the signature shows the name alone.
// TypeScript note: `import.meta.glob` lists the files that match at build
// time, so a missing file gives an empty object, not a build error.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/author.{jpg,png}', { eager: true });
const photo = Object.values(portraits)[0]?.default;
---

<Base lang={lang} title={s.meta.title} description={s.meta.description}>
  <section class="hero wrap">
    <h1>{s.hero.title}</h1>
    <p class="lead">{s.hero.lead}</p>
    <Download lang={lang} />
    <div class="hero-shot">
      <Shot lang={lang} name="inbox" alt={s.hero.shotAlt} caption={s.hero.caption} captionEnd eager />
    </div>
  </section>

  <section class="measures wrap" aria-labelledby="measures-title">
    <h2 id="measures-title" class="visually-hidden">{s.measures.title}</h2>
    <ul>
      {
        s.measures.items.map((m) => (
          <li>
            <span class="scale">{m.value}</span>
            <span class="measure-label">{m.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="measure-note">{s.measures.note}</p>
  </section>

  {
    s.pillars.map((p, i) => (
      <section class:list={['pillar', 'wrap', { flip: i % 2 === 1 }]} id={p.id} aria-labelledby={`${p.id}-title`}>
        <header class="pillar-head">
          <h2 id={`${p.id}-title`}>{p.title}</h2>
          <p>{p.lead}</p>
        </header>
        <div class="pillar-body">
          <div class="pillar-shot">
            <Shot lang={lang} name={p.shot} alt={p.shotAlt} caption={p.caption} />
          </div>
          <dl class="points">
            {p.points.map((pt) => (
              <div>
                <dt>{pt.title}</dt>
                <dd>{pt.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    ))
  }
  <p class="wrap more"><a href={href(lang, '/features/')}>{s.pillarMore}</a></p>

  <section class="band" aria-labelledby="try-title">
    <div class="wrap band-inner">
      <div>
        <h2 id="try-title">{s.tryIt.title}</h2>
        <p>{s.tryIt.text}</p>
        <p><a href={href(lang, '/docs/add-an-account/')}>{s.tryIt.link}</a></p>
      </div>
      <div>
        <h2>{s.migration.title}</h2>
        <p>{s.migration.text}</p>
        <p><a href={href(lang, '/docs/moving-to-nicemailer/')}>{s.migration.link}</a></p>
      </div>
    </div>
  </section>

  <section class="wrap duo">
    <div>
      <h2>{s.openSource.title}</h2>
      <p>{s.openSource.text}</p>
      <p><a href={REPO}>{s.openSource.link}</a></p>
    </div>
    <div class="author">
      <h2>{s.author.title}</h2>
      {s.author.text.map((para) => <p>{para}</p>)}
      <div class="signature">
        {photo && <Image src={photo} alt="" width={96} height={96} class="portrait" />}
        <p>
          <strong>{s.author.name}</strong>, {s.author.role}<br />
          <a href={LINKEDIN}>LinkedIn</a> · <a href={X}>X</a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title">{s.faq.title}</h2>
    <div class="faq-list">
      {
        s.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            {item.a.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </details>
        ))
      }
    </div>
  </section>

  <section class="wrap final">
    <h2>{s.final.title}</h2>
    <Download lang={lang} />
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero {
    padding-top: clamp(2.5rem, 7vw, 5.5rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.2vw, 5.4rem);
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .lead {
    margin-top: 1.4rem;
    max-width: var(--measure);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: var(--ink-2);
  }
  .hero :global(.download) {
    margin-top: 2rem;
  }
  .hero-shot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .measures {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .measures ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem 3rem;
  }
  .measures li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .measures .scale {
    font-size: clamp(2rem, 4vw, 2.7rem);
    letter-spacing: -0.02em;
  }
  .measure-label {
    max-width: 22rem;
  }
  .measure-note {
    margin-top: 1.6rem;
    font-size: 0.92rem;
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .pillar {
    margin-top: clamp(5rem, 11vw, 8.5rem);
  }
  .pillar-head h2 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: -0.03em;
  }
  .pillar-head p {
    margin-top: 0.8rem;
    max-width: var(--measure);
    font-size: 1.25rem;
    color: var(--ink-2);
  }
  .pillar-body {
    margin-top: 2.2rem;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 2.5rem 3.5rem;
    align-items: start;
  }
  .flip .pillar-body {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
  }
  .flip .pillar-shot {
    order: 2;
  }
  .points {
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  .points dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
  }
  .points dd {
    margin: 0.3rem 0 0;
    color: var(--ink-2);
    /* A "\n" in the text starts a new line. */
    white-space: pre-line;
  }
  @media (max-width: 56rem) {
    .pillar-body,
    .flip .pillar-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .flip .pillar-shot {
      order: 0;
    }
    .points {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }
  .more {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .band {
    margin-top: clamp(5rem, 10vw, 7rem);
    background: var(--band);
    color: var(--band-ink);
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .band-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 3rem 4rem;
  }
  .band h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
  }
  .band p {
    margin-top: 0.9rem;
    color: var(--band-ink-2);
    max-width: var(--measure);
  }
  .band a {
    color: var(--band-ink);
    font-family: var(--font-display);
    font-weight: 500;
  }

  .duo {
    margin-top: clamp(4rem, 9vw, 6rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 3rem 4rem;
  }
  .duo h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }
  .duo p {
    margin-top: 0.9rem;
    max-width: var(--measure);
  }
  .duo a {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .author p:not(:first-of-type) {
    color: var(--ink-2);
  }
  .author {
    border-left: 3px solid var(--leaf);
    padding-left: 1.5rem;
  }
  .signature {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .duo .signature p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .signature strong {
    color: var(--ink);
    font-weight: 600;
  }
  .portrait {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .faq {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .faq h2 {
    font-size: clamp(1.6rem, 3vw, 2rem);
  }
  .faq-list {
    margin-top: 1.2rem;
    max-width: 46rem;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    padding-block: 0.95rem;
    font-family: var(--font-display);
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--ink-2);
    font-weight: 500;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    color: var(--ink-2);
    max-width: var(--measure);
  }
  details p + p {
    margin-top: 0.5em;
  }
  details p:last-child {
    padding-bottom: 1.1rem;
  }

  .final {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .final h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: -0.03em;
    max-width: 18ch;
    margin-bottom: 1.8rem;
  }
</style>
